# Penny Stock Intelligence Engine - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=penny
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=penny_stocks
POSTGRES_PORT=5432

# Must match POSTGRES_* above (asyncpg driver for the app)
DATABASE_URL=postgresql+asyncpg://penny:change-me-to-a-strong-password@localhost:5432/penny_stocks
# Inside Docker Compose the host is `postgres`, e.g.:
# DATABASE_URL=postgresql+asyncpg://penny:change-me-to-a-strong-password@postgres:5432/penny_stocks
# Local smoke test without postgres (4 slashes = absolute path):
# DATABASE_URL=sqlite+aiosqlite:////tmp/smoke.db

# =============================================================================
# REDIS (optional - for caching)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# =============================================================================
# MARKET DATA PROVIDERS
# =============================================================================
# Alpha Vantage (free tier: 5 requests/minute, 500/day)
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub (free tier: 60 requests/minute)
# Get key at: https://finnhub.io/register
FINNHUB_API_KEY=

# Polygon.io (paid, but generous free tier)
# Get key at: https://polygon.io/
POLYGON_API_KEY=

# Twelve Data
# Get key at: https://twelvedata.com/
TWELVE_DATA_API_KEY=

# =============================================================================
# AI PROVIDERS (for news/filing classification)
# =============================================================================
# OpenAI
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# =============================================================================
# ALERT PROVIDERS
# =============================================================================
# Telegram Bot
# Create bot with @BotFather, get token
TELEGRAM_BOT_TOKEN=
# Get chat ID by messaging @userinfobot or checking bot updates
TELEGRAM_CHAT_ID=

# Discord Webhook
# Create webhook in Discord channel settings
DISCORD_WEBHOOK_URL=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Generic Webhook
WEBHOOK_URL=
WEBHOOK_SECRET=

# =============================================================================
# SEC EDGAR
# =============================================================================
# Required for SEC filings - use a proper user agent with contact info
SEC_EDGAR_USER_AGENT="PennyStockIntelligence/0.1 (your_email@example.com)"

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32

# Paper trading mode (always true for this project)
PAPER_MODE=true
LIVE_TRADING=false

# API Security
# Required when ENVIRONMENT=production|staging (or set REQUIRE via security.require_api_key)
API_KEY=your-secure-api-key-here
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60
# Optional overrides (comma-separated origins; leave empty to use config/settings.yaml)
# CORS_ORIGINS=https://dash.example.com,https://app.example.com